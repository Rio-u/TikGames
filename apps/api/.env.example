PORT=4000
# Postgres (Supabase). From Supabase -> Connect -> ORM (Prisma), copy BOTH lines and put
# your database password in place of [YOUR-PASSWORD]. DATABASE_URL = transaction pooler
# (port 6543) for the app; DIRECT_URL = session pooler (port 5432) for migrations / db push.
# Both are IPv4, so the same values work locally and on Render. Same DB for dev and prod.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# Where OAuth callbacks (TikTok/Discord) redirect the browser back to after signing in.
DASHBOARD_URL="http://localhost:5173"

# TikTok Login Kit — https://developers.tiktok.com
TIKTOK_OAUTH_CLIENT_KEY=""
TIKTOK_OAUTH_CLIENT_SECRET=""
TIKTOK_OAUTH_REDIRECT_URI="http://localhost:4000/auth/tiktok/callback"

# Discord OAuth2 — https://discord.com/developers/applications
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
DISCORD_OAUTH_REDIRECT_URI="http://localhost:4000/auth/discord/callback"

# Must match apps/tiktok-connector/.env's CONNECTOR_INTERNAL_SECRET exactly.
CONNECTOR_INTERNAL_SECRET="dev-internal-secret-change-me"

# Optional — Discord incoming webhook URL. When set, mirrors every admin action and every
# WARNING/CRITICAL alert there. Leave empty to disable.
DISCORD_ADMIN_LOG_WEBHOOK_URL=""

# Cloudflare Turnstile — dash.cloudflare.com. Leave empty to disable CAPTCHA verification.
TURNSTILE_SECRET_KEY=""

# --- Desktop app licensing (Electron .exe gate) ---------------------------------------
# Shared product password users type to activate the desktop app. Fail-closed: unset = nobody
# can activate. Change it to rotate access.
LICENSE_PASSWORD=""
# New devices land PENDING and wait for your Discord approval. Set to 1 to auto-approve instead.
LICENSE_AUTO_APPROVE=""
# Signs the device session token. Falls back to JWT_ACCESS_SECRET if unset.
LICENSE_JWT_SECRET=""
# Discord admin console (the bot with approve/block/kill). The token lives ONLY here, never in the
# shipped exe. Create a bot at https://discord.com/developers, invite it to your server with the
# applications.commands scope.
DISCORD_BOT_TOKEN=""
# Your server (guild) id — makes slash commands register instantly instead of ~1h globally.
DISCORD_GUILD_ID=""
# Comma-separated Discord user ids allowed to run the licence commands. Empty = nobody.
DISCORD_ADMIN_USER_IDS=""
