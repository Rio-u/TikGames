API_INTERNAL_URL="http://localhost:4000"
CONNECTOR_INTERNAL_SECRET="dev-internal-secret-change-me"

# TikTok signing provider — https://www.eulerstream.com (free tier works to start).
# Without this, connecting to a real TikTok LIVE room will fail (fetchRoomInfoOnConnect
# and the WebSocket handshake both need a valid signature).
EULER_STREAM_API_KEY=""
