// TikGames — core database schema (PostgreSQL, hosted on Supabase).
// See root README.md for the architecture this schema supports, and DEPLOY.md §1 for the
// Supabase connection string that DATABASE_URL points at (one cloud DB for dev and production).
//
// Postgres enforces relations as real foreign keys: onDelete: Cascade and friends run at the
// database level, and Prisma's transactions / nested writes work without any special server
// configuration.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STREAMER
  ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PaymentProvider {
  MANUAL
  PAYMOB
  PAYTABS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AuthMethod {
  EMAIL_PASSWORD
  TIKTOK
  DISCORD
}

enum LiveSourcePlatform {
  TIKTOK
  KICK
}

enum LiveSessionStatus {
  PENDING
  CONNECTING
  LIVE
  ENDED
  ERROR
}

enum GameType {
  MUSICAL_CHAIRS
  TRIVIA
  GUESS_NUMBER
  SPIN_WHEEL
  WOULD_YOU_RATHER
  FLAGS
  CAPITALS
  LOGOS
  SPEED_WORD
  MAZE
  DRAWING
  WORD_ROUND
}

enum GameSessionStatus {
  PENDING
  ACTIVE
  PAUSED
  ENDED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique // handle, distinct from displayName — ASCII only
  passwordHash String? // null if the account was created via OAuth only
  displayName  String
  avatarUrl    String?
  role         UserRole @default(STREAMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription         Subscription?
  tikTokAccount        TikTokAccount?
  discordAccount       DiscordAccount?
  liveSessions         LiveSession[]
  gameConfigs          GameConfig[]
  refreshTokens        RefreshToken[]
  resolvedAlerts       Alert[]                 @relation("AlertResolvedBy")
  adminActions         AdminActionLog[]        @relation("AdminActor")
  activatedSubs        Subscription[]          @relation("SubscriptionActivatedBy")
  uploadedTriviaImages TriviaBackgroundImage[] @relation("TriviaImageUploader")
  uploadedMusicTracks  MusicalChairsTrack[]    @relation("MusicTrackUploader")
  uploadedSpeedWordImages SpeedWordBackgroundImage[] @relation("SpeedWordImageUploader")
  viewerRankings       ViewerRanking[]
  createdRedemptionCodes  RedemptionCode[]        @relation("RedemptionCodeCreator")
  redeemedRedemptionCodes RedemptionCode[]        @relation("RedemptionCodeRedeemer")
  overlayWidgetConfigs    OverlayWidgetConfig[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String   
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TikTokAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String // @handle to watch live
  tiktokUserId   String? // set only if connected via TikTok OAuth login
  displayName    String?
  avatarUrl      String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tiktokUserId])
}

model DiscordAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordUserId  String // Discord's numeric snowflake id
  username       String // Discord handle at time of connect
  avatarUrl      String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([discordUserId])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime
  // Usage-based trial (replaces trialEndsAt as the actual enforcement mechanism — trialEndsAt
  // stays for historical display only). trialGamesLimit is snapshotted from PlatformSettings at
  // signup, then only ever increased afterward (admin grants, redemption codes) — never derived
  // live from the platform default, so a later admin change doesn't retroactively affect someone
  // who already registered.
  trialGamesLimit  Int                @default(3)
  trialGamesUsed   Int                @default(0)
  currentPeriodEnd DateTime?
  activatedById    String?           
  activatedBy      User?              @relation("SubscriptionActivatedBy", fields: [activatedById], references: [id])
  activatedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]
}

model Payment {
  id             String          @id @default(cuid())
  subscriptionId String         
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  provider       PaymentProvider
  providerRef    String?
  amount         Int // stored in minor currency units (e.g. cents/qirsh) to avoid float money bugs
  currency       String          @default("USD")
  status         PaymentStatus   @default(PENDING)
  rawPayload     Json?
  createdAt      DateTime        @default(now())

  @@index([subscriptionId])
}

model LiveSession {
  id                  String             @id @default(cuid())
  userId              String            
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform            LiveSourcePlatform @default(TIKTOK)
  channelUsername     String
  status              LiveSessionStatus  @default(PENDING)
  overlayToken        String             @unique @default(cuid())
  connectorInstanceId String?
  startedAt           DateTime?
  endedAt             DateTime?
  lastHeartbeatAt     DateTime?
  createdAt           DateTime           @default(now())

  gameSessions GameSession[]
  alerts       Alert[]

  @@index([userId])
  @@index([status])
}

model GameConfig {
  id        String   @id @default(cuid())
  userId    String  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType  GameType
  name      String
  settings  Json // shape depends on gameType (duration, keywords, choices, ...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameSessions GameSession[]

  @@index([userId, gameType])
}

model GameSession {
  id            String            @id @default(cuid())
  liveSessionId String           
  liveSession   LiveSession       @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  gameConfigId  String?          
  gameConfig    GameConfig?       @relation(fields: [gameConfigId], references: [id])
  gameType      GameType
  status        GameSessionStatus @default(PENDING)
  state         Json              @default("{}") // runtime state-machine snapshot
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime          @default(now())

  participants GameSessionParticipant[]

  @@index([liveSessionId])
}

model GameSessionParticipant {
  id            String      @id @default(cuid())
  gameSessionId String     
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  viewerHandle  String // TikTok commenter username — no separate viewer account
  displayName   String?
  score         Int         @default(0)
  metadata      Json?
  joinedAt      DateTime    @default(now())

  @@unique([gameSessionId, viewerHandle])
  @@index([gameSessionId])
}

model Alert {
  id            String        @id @default(cuid())
  severity      AlertSeverity
  status        AlertStatus   @default(OPEN)
  source        String // e.g. "tiktok-connector"
  liveSessionId String?      
  liveSession   LiveSession?  @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  message       String
  detail        Json?
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?
  resolvedById  String?      
  resolvedBy    User?         @relation("AlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, severity])
}

model AdminActionLog {
  id           String   @id @default(cuid())
  adminUserId  String  
  adminUser    User     @relation("AdminActor", fields: [adminUserId], references: [id])
  action       String // e.g. "SUBSCRIPTION_ACTIVATED"
  targetUserId String? 
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([adminUserId])
}

// Platform-wide (not per-user) pool of background images for the Trivia game, curated by
// admins only — every streamer's Trivia session draws a random image from this same pool.
model TriviaBackgroundImage {
  id           String   @id @default(cuid())
  url          String
  uploadedById String  
  uploadedBy   User     @relation("TriviaImageUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

// Platform-wide (not per-user) pool of background images for the Speed Word game — same
// precedent as TriviaBackgroundImage, every streamer's session draws a random image from here.
model SpeedWordBackgroundImage {
  id           String   @id @default(cuid())
  url          String
  uploadedById String  
  uploadedBy   User     @relation("SpeedWordImageUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

// Platform-wide per-game kill switch, admin-controlled. A missing row means enabled (fail-open,
// so this never blocks a GameType nobody has touched) — see POST /games/session/start.
model GameToggle {
  id          String   @id @default(cuid())
  gameType    GameType @unique
  enabled     Boolean  @default(true)
  updatedById String? 
  updatedAt   DateTime @updatedAt
}

// Platform-wide (not per-user) admin-editable overrides for a game's library-card presentation
// and control-page explainer content. Missing row (or a null field within an existing row) means
// "use the hardcoded GameDefinition in apps/dashboard/src/data/games.ts instead" — same fail-open
// precedent as GameToggle. emoji/gradient/route are never part of this model (stay hardcoded).
model GameContent {
  id            String   @id @default(cuid())
  gameType      GameType @unique
  nameAr        String?
  descriptionAr String?
  bioAr         String? // "شرح اللعبة" — prose, rendered whitespace-pre-line on the control page
  rulesAr       String? // "قواعد التشغيل" — plain multi-line string, one rule per line, split into a bullet list client-side
  imageUrl      String?
  updatedById   String? 
  updatedAt     DateTime @updatedAt
}

// Platform-wide dashboard homepage content — a single admin-managed row (the `key` unique field
// is always "homepage", giving this a stable target to upsert/query without needing a real
// singleton primitive). `featuredGameTypes` picks up to 3 games for the dashboard's "spotlight"
// row above the full library grid; both fields are independently optional — an unset heroTitle
// just means no hero banner, an empty featuredGameTypes just means no spotlight row, and the
// dashboard falls back to exactly today's layout until an admin sets either.
model HomepageSettings {
  id                String     @id @default(cuid())
  key               String     @unique @default("homepage")
  heroTitle         String?
  featuredGameTypes GameType[]
  updatedById       String?   
  updatedAt         DateTime   @updatedAt
}

/// One streamer's customisation of one overlay widget (colours, size, labels, ...).
/// Sparse by design: a row exists only for a widget the streamer actually edited, and the shape
/// of `settings` is validated against that widget's `fields` in OVERLAY_WIDGET_CATALOG rather
/// than by a column per option — a new field in the catalog must not require a migration.
model OverlayWidgetConfig {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Matches OverlayWidgetId in shared-types. Kept as a String, not an enum, so adding a widget
  /// is a catalog edit rather than a schema migration + db push.
  widgetId String

  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, widgetId])
  @@index([userId])
}

// Registration-method kill switch, admin-controlled — same fail-open precedent as GameToggle (a
// missing row means enabled). Only gates NEW account creation, never an existing user logging back
// in via a method that's since been disabled — see POST /register, GET /tiktok|discord/start, and
// the new-account branch of both OAuth callbacks in apps/api/src/routes/auth.ts.
model AuthMethodToggle {
  id          String     @id @default(cuid())
  method      AuthMethod @unique
  enabled     Boolean    @default(true)
  updatedById String?   
  updatedAt   DateTime   @updatedAt
}

// Platform-wide singleton (same key-based pattern as HomepageSettings). defaultTrialGames is
// snapshotted onto Subscription.trialGamesLimit at signup — changing it here only affects accounts
// registered afterward.
model PlatformSettings {
  id                String   @id @default(cuid())
  key               String   @unique @default("platform")
  defaultTrialGames Int      @default(3)
  /// Which of the nine pre-roll 3D designs plays before every game, platform-wide. Admin-only and
  /// deliberately not a per-streamer setting: it is part of the product's look, not a preference.
  /// Null means the registry default (Energy Tunnel).
  countdownDesignId String?
  updatedById       String? 
  updatedAt         DateTime @updatedAt
}

// Admin-generated, single-use, single-account bonus-games code. Redemption is a single atomic
// updateMany guarded on redeemedById: null (see POST /account/redeem-code) — never read-then-write,
// so two simultaneous redemption attempts on the same code can't both succeed.
model RedemptionCode {
  id           String    @id @default(cuid())
  code         String    @unique
  gamesGranted Int
  createdById  String   
  createdBy    User      @relation("RedemptionCodeCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  redeemedById String?  
  redeemedBy   User?     @relation("RedemptionCodeRedeemer", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?
}

// Permanent per-streamer viewer leaderboard: how many points a given TikTok handle has earned
// across every game session played in a given streamer's lives, ever — independent per streamer
// (the same handle can rank differently, or not at all, with a different streamer). Updated
// incrementally from apps/api/src/routes/games.ts's generic onChange callback, never recomputed
// from scratch — see apps/api/src/lib/leaderboard.ts.
model ViewerRanking {
  id           String   @id @default(cuid())
  streamerId   String  
  streamer     User     @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  viewerHandle String
  displayName  String
  avatarUrl    String?
  totalScore   Int      @default(0)
  gamesPlayed  Int      @default(0)
  lastPlayedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([streamerId, viewerHandle])
  @@index([streamerId, totalScore])
}

// Platform-wide (not per-user) pool of music tracks for Musical Chairs' "music playing" phase,
// curated by admins only — same precedent as TriviaBackgroundImage. Each session picks one at
// random when it starts (see MusicalChairsEngine); an empty pool just means no music, not a
// blocked session — music is atmosphere, not required content.
model MusicalChairsTrack {
  id           String   @id @default(cuid())
  url          String
  uploadedById String  
  uploadedBy   User     @relation("MusicTrackUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

// --- Desktop app licensing ---------------------------------------------------------
//
// The Electron desktop build is gated by a per-device licence you approve by hand from a Discord
// admin bot. A device registers with the shared product password, lands as PENDING, and stays
// locked until you APPROVE it; BLOCKED is the remote kill switch. The client polls
// /licensing/heartbeat, so an approve or a kill takes effect within one heartbeat, live.
//
// Privacy by design: we store a *hash* of the machine's stable hardware attributes, never the raw
// MAC/serials, plus the hostname and OS username the OS already exposes — the minimum needed to
// tell one approved laptop from an unknown one. This is disclosed to the user in the app's
// activation screen; it is licence enforcement, not surveillance of the person's computer.
enum LicenseDeviceStatus {
  PENDING
  APPROVED
  BLOCKED
}

model LicenseDevice {
  id          String              @id @default(cuid())
  /// sha256 of the device's stable hardware attributes — the identity, and unique per machine.
  machineHash String              @unique
  /// Optional label the person typed at activation ("لابتوب البيت"), for your own recognition.
  label       String?
  hostname    String?
  osUser      String?
  platform    String? // win32 | darwin | linux
  appVersion  String?
  status      LicenseDeviceStatus @default(PENDING)
  lastIp      String?
  /// Who acted on it from Discord (tag/id), and when — a light audit trail on the row itself.
  approvedBy  String?
  approvedAt  DateTime?
  blockedBy   String?
  blockedAt   DateTime?
  blockReason String?
  firstSeenAt DateTime            @default(now())
  lastSeenAt  DateTime            @default(now())

  @@index([status])
}

// Durable audit of licence events, in addition to the Discord mirror. Deliberately app-scoped:
// registrations, heartbeats that changed something, approvals, blocks — never the contents of the
// user's machine.
model LicenseAuditEvent {
  id          String   @id @default(cuid())
  machineHash String?
  type        String // register | approve | block | kill | reactivate | heartbeat-blocked
  detail      Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([machineHash])
  @@index([createdAt])
}
