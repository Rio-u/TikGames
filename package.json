{
  "name": "tikgames",
  "private": true,
  "version": "0.1.0",
  "description": "TikGames — interactive TikTok Live overlay games platform for streamers.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "pnpm --filter @tikgames/database run generate",
    "db:push": "pnpm --filter @tikgames/database run migrate",
    "db:studio": "pnpm --filter @tikgames/database run studio"
  },
  "devDependencies": {
    "mongosh": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "mongosh",
      "esbuild"
    ]
  }
}
